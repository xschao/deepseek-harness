{
  "name": "@deepseek-ai/dsh-ima-kb",
  "version": "0.2.2-rc.3",
  "type": "module",
  "description": "IMA 知识库侧边栏插件：左侧菜单新增 IMA 入口，知识库名称+id 多选、组合问答，以及文档列表/上传/改名/删除",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src/index.js",
    "src/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xschao/deepseek-harness.git",
    "directory": "plugins/ima-kb"
  },
  "deepseekHarness": {
    "repository": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "release": "dsh-v0.2.2-rc.3",
    "version": "0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ima",
    "knowledge-base"
  ],
  "scripts": {
    "build": "node scripts/sync.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
